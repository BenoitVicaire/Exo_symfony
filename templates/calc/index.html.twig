{% extends 'base.html.twig' %}

{% block title %}Hello CalcController!{% endblock %}

{% block body %}
<h1>Calculatrice</h1>
<form action="{{ path('app_calc') }}">
	<input type="number" name="nb1" id="nb1" placeholder="Nombre">
	<select name="operateur" id="operateur">
		<option value="+">+</option>
		<option value="-">-</option>
		<option value="*">*</option>
		<option value="/">/</option>
	</select>
	<input type="number" name="nb2" id="nb2" placeholder="Nombre">
	<button type="submit">Calculer</button>
</form>
{% if result is not null %}
	<p>Le resultat est :{{ result }}</p>
{% endif %}
{% if error %}
	<p>{{error}}</p>
{% endif %}
{% endblock %}
