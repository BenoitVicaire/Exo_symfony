{% extends 'cheatsheet/layout.html.twig' %}

{% block title %}CheatSheet : controller{% endblock %}

{% block sheet %}
{% verbatim %}
<h1 class="text-3xl font-bold mb-6">Controller</h1>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Créer un contrôleur</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>php bin/console make:controller NomController</code></pre>
    <p class="mt-2">Crée <code>src/Controller/NomController.php</code> et <code>templates/nom/index.html.twig</code>.</p>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Route avec attribut</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>namespace App\Controller;   // toujours App\Controller

use Symfony\Bundle\FrameworkBundle\Controller\AbstractController;
use Symfony\Component\HttpFoundation\Response;
use Symfony\Component\Routing\Attribute\Route;

final class ContactController extends AbstractController
{
    #[Route('/contact', name: 'app_contact')]
    public function index(): Response
    {
        return $this->render('contact/index.html.twig', [
            'email' => 'contact@exemple.fr',
        ]);
    }
}</code></pre>
    <p class="mt-2">Les clés du tableau deviennent les variables du template : <code>{{ email }}</code>.</p>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Route en YAML</h2>
    <p class="mb-2">Dans <code>config/routes.yaml</code>, sans attribut dans le contrôleur :</p>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>app_home:
  path: /
  controller: App\Controller\HomeController::index</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Paramètre dans l'URL</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>#[Route('/livres/detail/{id}', name: 'app_book_detail', requirements: ['id' => '\d+'])]
public function detail(int $id): Response</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Paramètre en query string (?nb1=3)</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>// Avec la requête
public function index(Request $request): Response
{
    $nb1 = $request->query->get('nb1');   // null si absent
}

// Avec l'attribut (le nom de la variable = le nom du paramètre)
public function index(#[MapQueryParameter] int $nb1 = 0): Response</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Redirection et erreur 404</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>return $this->redirectToRoute('app_book_detail', ['id' => 3]);

throw $this->createNotFoundException('Livre introuvable');</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Injecter un service</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>public function __construct(private UserService $userService)
{
}
// puis : $this->userService->getUsers()</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Vérifier les routes</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>php bin/console debug:router
php bin/console debug:router app_contact</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Twig : l'essentiel</h2>
<pre class="bg-base-300 rounded-box p-4 text-sm overflow-x-auto"><code>{% extends 'base.html.twig' %}

{% block title %}Mon titre{% endblock %}

{% block body %}
    {{ user.firstname ~ ' ' ~ user.lastname }}

    {% for book in books %}
        &lt;a href="{{ path('app_book_detail', {id: book.id}) }}">{{ book.title }}&lt;/a>
    {% else %}
        Aucun livre.
    {% endfor %}

    {% if result is not null %}{{ result }}{% endif %}
{% endblock %}</code></pre>
</section>

<section class="mb-8">
    <h2 class="text-xl font-bold mb-2">Erreurs fréquentes</h2>
    <ul class="list-disc pl-6 space-y-1">
        <li><code>Cannot redeclare class</code> : le namespace ne correspond pas au dossier.</li>
        <li><code>Variable "x" does not exist</code> : clé absente ou mal orthographiée dans le tableau de <code>render()</code>.</li>
        <li><code>Unable to find template</code> : le chemin dans <code>render()</code> ne correspond pas au fichier.</li>
        <li><code>path('nom')</code> échoue : c'est le <em>name</em> de la route qu'il faut, pas le chemin.</li>
        <li>Le <code>+</code> dans une URL doit être encodé <code>%2B</code>.</li>
    </ul>
</section>
{% endverbatim %}
{% endblock %}
