{% props action, tokenId, message, label = 'Supprimer' %}

{% set modal_id = 'modal-' ~ tokenId %}

<button
	type="button"
	class="btn btn-error btn-sm"
	onclick="document.getElementById('{{ modal_id }}').showModal()"
>
	{{ label }}
</button>

<dialog id="{{ modal_id }}" class="modal">
	<div class="modal-box">
		<p>{{ message }}</p>

		<div class="modal-action">
			{# Annuler : un form method="dialog" ferme la fenêtre sans rien envoyer #}
			<form method="dialog">
				<button class="btn">Annuler</button>
			</form>

			{# Le vrai formulaire de suppression #}
			<form method="post" action="{{ action }}">
				<input type="hidden" name="_token" value="{{ csrf_token(tokenId) }}">
				<button type="submit" class="btn btn-error">Confirmer</button>
			</form>
		</div>
	</div>

	{# Clic en dehors de la boîte : ferme la fenêtre #}
	<form method="dialog" class="modal-backdrop">
		<button>Fermer</button>
	</form>
</dialog>
