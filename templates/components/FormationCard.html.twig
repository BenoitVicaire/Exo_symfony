{% props formation %}

<div class="card w-96 bg-base-100 shadow-xl">
  <div class="card-body">
	<h2 class="card-title">{{ formation.title }}</h2>
	<twig:Badge 
		:label="formation.difficulty.value" 
		:variant="formation.difficulty.variant" />
	<p>{{ formation.description }}</p>
	<div class="card-actions justify-end">
	  <button class="btn btn-primary" disabled>Commencer la formation</button>
	</div>
  </div>
</div>