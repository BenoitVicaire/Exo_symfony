{# Section détaillée d'une étape. Le numéro et le titre viennent du tableau `steps` (source unique). #}
{% props steps, step %}

{% set n = 0 %}
{% for key in steps|keys %}
    {% if key == step %}{% set n = loop.index %}{% endif %}
{% endfor %}

<section id="{{ step }}" class="mb-8 scroll-mt-4">
    <h2 class="text-xl font-bold mb-2">
        <span class="badge badge-primary mr-2">Étape {{ n }}</span>{{ steps[step] }}
    </h2>
    {% block content %}{% endblock %}
    <a href="#etapes" class="link link-hover text-sm opacity-60 mt-3 inline-block">&uarr; Retour aux étapes</a>
</section>
