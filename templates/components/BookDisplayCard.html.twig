{% props books %}

<div class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Mes supers bouquins</h1>

    <form action="{{ path('app_book_search') }}" method="get" class="join w-full mb-4">
        <input type="text" name="title" id="title" placeholder="Titre du livre" class="input input-bordered join-item w-full">
        <button type="submit" class="btn btn-primary join-item">Chercher</button>
    </form>

    {% if error is defined and error %}
        <twig:Alert type="error" :message="error" class="mb-4" />
    {% endif %}

    <div class="overflow-x-auto rounded-box border border-base-300">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                    <th>Catégories</th>
                    <th>Loué par</th>
                </tr>
            </thead>
            <tbody>
                {% for book in books %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td><a href="{{ path('app_book_detail', {id: book.id}) }}" class="link link-primary">{{ book.title }}</a></td>
                        <td>{{ book.author }}</td>
                        <td>
                            <div class="flex flex-wrap gap-1">
                                {% for category in book.categories %}
                                    <a href="{{ path('app_category_show', {id: category.id}) }}" class="badge badge-outline">{{ category.name }}</a>
                                {% else %}
                                    <span class="opacity-50">Aucune</span>
                                {% endfor %}
                            </div>
                        </td>
                        <td>
                            {% if book.user %}
                                <a href="{{ path('app_user_show', {id: book.user.id}) }}" class="link link-hover">{{ book.user.firstname ~ ' ' ~ book.user.lastname }}</a>
                            {% else %}
                                <span class="opacity-50">Disponible</span>
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>