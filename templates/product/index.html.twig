{% extends 'base.html.twig' %}

{% block title %}Hello ProductController!{% endblock %}

{% block body %}
<h1>Page produit</h1>
<h2>Veuillez saisir l'id d'un produit</h2>
<form action="">
	<input type="number" name="id" id="id" placeholder="id">
	<button type="submit"> Chercher</button>
</form>
{% if error is defined %}
    <p>{{ error }}</p>
{% endif %}
{% endblock %}
