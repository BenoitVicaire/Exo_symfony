{# Carte commune à la connexion et à l'inscription, avec les deux onglets. #}
{# Les pages filles remplissent le bloc `auth_form`. #}
{% extends 'base.html.twig' %}

{% block body %}
<div class="mx-auto max-w-md px-4 py-8">
    <div class="card bg-base-200 shadow-sm">
        <div class="card-body">
            <div role="tablist" class="tabs tabs-border w-full">
                <a href="{{ path('app_login') }}" role="tab"
                   class="tab flex-1 {{ app.current_route == 'app_login' ? 'tab-active' : '' }}">Connexion</a>
                <a href="{{ path('app_register') }}" role="tab"
                   class="tab flex-1 {{ app.current_route == 'app_register' ? 'tab-active' : '' }}">Inscription</a>
            </div>

            <div class="mt-4">
                {% block auth_form %}{% endblock %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
