{% extends 'base.html.twig' %}

{% block title %}Livres{% endblock %}

{% block body %}
<div class="mx-auto max-w-3xl px-4 py-8">
    <h1 class="text-3xl font-bold mb-6">Mes supers bouquins</h1>

    <form action="{{ path('app_book') }}" class="join w-full mb-4">
        <input type="text" name="book_id" id="book_id" placeholder="Id du livre" class="input input-bordered join-item w-full">
        <button type="submit" class="btn btn-primary join-item">Chercher</button>
    </form>

    {% if error is defined and error %}
        <twig:Alert type="error" :message="error" class="mb-4" />
    {% endif %}

    <div class="overflow-x-auto rounded-box border border-base-300">
        <table class="table table-zebra">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Titre</th>
                    <th>Auteur</th>
                </tr>
            </thead>
            <tbody>
                {% for book in books %}
                    <tr>
                        <td>{{ book.id }}</td>
                        <td><a href="{{ path('app_book_detail', {id: book.id}) }}" class="link link-primary">{{ book.title }}</a></td>
                        <td>{{ book.author }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
