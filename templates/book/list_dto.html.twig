{% extends 'base.html.twig' %}

{% block title %}Livres (DTO){% endblock %}

{% block body %}
<div class="mx-auto max-w-4xl px-4 py-8">
    <div class="flex flex-wrap items-end justify-between gap-2 mb-6">
        <div>
            <h1 class="text-3xl font-bold">Liste des livres</h1>
            <p class="opacity-70">Version allégée : uniquement les champs du <code>BookListDto</code>.</p>
        </div>
        <span class="badge badge-neutral">{{ books|length }} livre{{ books|length > 1 ? 's' : '' }}</span>
    </div>

    {% if books is empty %}
        <twig:Alert message="Aucun livre." />
    {% else %}
        <div class="overflow-x-auto rounded-box border border-base-300">
            <table class="table table-zebra">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Publié le</th>
                    </tr>
                </thead>
                <tbody>
                    {% for book in books %}
                        <tr class="hover:bg-base-300">
                            <td class="opacity-60">{{ book.id }}</td>
                            <td class="font-medium">
                                <a href="{{ path('app_book_detailID', {id: book.id}) }}" class="link link-primary">{{ book.title }}</a>
                            </td>
                            <td>{{ book.author }}</td>
                            <td class="whitespace-nowrap">{{ book.publishAt|date('d/m/Y') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
